@model IEnumerable<NutShop.Models.Product>

@{
    ViewData["Title"] = "Products";
}

<h1>Shop Our Products</h1>

<div class="products-grid">
    @foreach (var product in Model)
    {
        <div class="product-card">
            <div class="product-image-wrapper">
                @if (!string.IsNullOrEmpty(product.ImageUrl))
                {
                    <img src="@product.ImageUrl" alt="@product.Name" class="product-image"
                         style="width:100%;height:160px;object-fit:cover;object-position:center;display:block;" />
                }
                else
                {
                    <div class="product-image-placeholder" style="height:160px;"></div>
                }
            </div>

            <div class="product-info">
                <h3>@product.Name</h3>
                <p class="price">@product.Price kr</p>

                @if (product.StockQuantity > 0)
                {
                    <form method="post" action="/Cart/AddToCart" class="add-to-cart-form">
                        <input type="hidden" name="productId" value="@product.Id" />
                        <div class="quantity-control">
                            <input type="number" name="quantity" value="1" min="1" max="@product.StockQuantity" class="quantity-input" />
                            <button type="submit" class="btn btn-add-cart">Add to Basket</button>
                        </div>
                    </form>
                }
                else
                {
                    <p class="out-of-stock">Out of Stock</p>
                }

                @if (Context.Session.GetString("AdminLoggedIn") == "true")
                {
                    <a href="/Admin/EditProduct/@product.Id" class="btn btn-edit-admin">Edit</a>
                }
            </div>
        </div>
    }
</div>