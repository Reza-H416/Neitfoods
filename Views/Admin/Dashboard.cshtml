@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="admin-status-bar">
    <span>&#x1F512; Logged in as <strong>Admin</strong></span>
    <form method="post" action="/Admin/Logout" style="display:inline; margin-left:1rem;">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn-logout-sm">Logout</button>
    </form>
</div>

<h2>Admin Dashboard</h2>

<div class="admin-menu">
    <div class="admin-card">
        <h3>Products Management</h3>
        <p>Manage products, categories, and inventory</p>
        <a href="/Admin/Products" class="btn">Go to Products</a>
    </div>
    <div class="admin-card">
        <h3>Orders Management</h3>
        <p>View and manage customer orders</p>
        <a href="/Admin/Orders" class="btn">Go to Orders</a>
    </div>
</div>