@model List<NutShop.Models.Order>

@{
    ViewData["Title"] = "Orders Management";
}

<div class="admin-orders">
    <h1>Orders Management</h1>

    @if (Model.Any())
    {
        <div class="orders-table-wrapper">
            <table class="orders-table">
                <thead>
                    <tr>
                        <th>Order ID</th>
                        <th>Customer</th>
                        <th>Email</th>
                        <th>Date</th>
                        <th>Amount</th>
                        <th>Status</th>
                        <th>Items</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model.OrderByDescending(o => o.OrderDate))
                    {
                        <tr>
                            <td><strong>#@order.Id</strong></td>
                            <td>@order.User?.FullName</td>
                            <td>@order.Email</td>
                            <td>@order.OrderDate.ToString("MMM dd, yyyy")</td>
                            <td>₹@order.TotalAmount.ToString("N0")</td>
                            <td>
                                <span class="status-badge status-@order.Status.ToLower()">
                                    @order.Status
                                </span>
                            </td>
                            <td>@order.OrderItems?.Count()</td>
                            <td>
                                <a href="@Url.Action("OrderDetails", new { id = order.Id })" class="btn btn-sm">View</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <p>No orders found.</p>
    }
</div>

<style>
.admin-orders {
    padding: 2rem;
}

.admin-orders h1 {
    margin-bottom: 2rem;
}

.orders-table-wrapper {
    background: white;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
}

.orders-table {
    width: 100%;
    border-collapse: collapse;
}

.orders-table thead {
    background: #f8f9fa;
}

.orders-table th {
    padding: 1rem;
    text-align: left;
    font-weight: bold;
    border-bottom: 2px solid #ddd;
}

.orders-table td {
    padding: 1rem;
    border-bottom: 1px solid #eee;
}

.status-badge {
    padding: 0.5rem 1rem;
    border-radius: 20px;
    font-size: 0.9rem;
    font-weight: bold;
    display: inline-block;
}

.status-badge.status-pending {
    background: #fff3cd;
    color: #856404;
}

.status-badge.status-processing {
    background: #d1ecf1;
    color: #0c5460;
}

.status-badge.status-shipped {
    background: #d4edda;
    color: #155724;
}

.status-badge.status-delivered {
    background: #d4edda;
    color: #155724;
}

.btn-sm {
    padding: 0.5rem 1rem;
    background-color: #667eea;
    color: white;
    border: none;
    border-radius: 4px;
    cursor: pointer;
    text-decoration: none;
    display: inline-block;
}

.btn-sm:hover {
    background-color: #5568d3;
}

@@media (max-width: 768px) {
    .orders-table {
        font-size: 0.9rem;
    }

    .orders-table th, .orders-table td {
        padding: 0.75rem;
    }
}
