@model IEnumerable<NutShop.Models.CartItem>

@{
    ViewData["Title"] = "Shopping Cart";
}

<div class="cart-page">
    <h1>Shopping Cart</h1>

    @if (Model.Any())
    {
        <div class="cart-container">
            <div class="cart-items">
                <table class="cart-table">
                    <thead>
                        <tr>
                            <th>Product</th>
                            <th>Price</th>
                            <th>Quantity</th>
                            <th>Total</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="product-info">
                                    <strong>@item.Product?.Name</strong>
                                    <p class="product-desc">@item.Product?.Description</p>
                                </td>
                                <td class="price">₹@item.UnitPrice</td>
                                <td class="quantity">
                                    <form method="post" asp-action="UpdateQuantity" style="display: flex; gap: 0.5rem;">
                                        <input type="hidden" name="cartItemId" value="@item.Id" />
                                        <input type="number" name="quantity" value="@item.Quantity"
                                               min="1" max="@item.Product?.StockQuantity" class="qty-input" />
                                        <button type="submit" class="btn btn-sm">Update</button>
                                    </form>
                                </td>
                                <td class="total">₹@(item.UnitPrice * item.Quantity)</td>
                                <td class="remove">
                                    <form method="post" asp-action="RemoveFromCart" style="display: inline;"
                                          onsubmit="return confirm('Remove this item?');">
                                        <input type="hidden" name="cartItemId" value="@item.Id" />
                                        <button type="submit" class="btn btn-sm btn-danger">Remove</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="cart-summary">
                <div class="summary-card">
                    <h3>Order Summary</h3>

                    <div class="summary-row">
                        <span>Subtotal:</span>
                        <span>₹@(Model.Sum(x => x.UnitPrice * x.Quantity) - (Model.Sum(x => x.UnitPrice * x.Quantity) * 0.05m))</span>
                    </div>

                    <div class="summary-row">
                        <span>Shipping:</span>
                        <span>₹100</span>
                    </div>

                    <div class="summary-row">
                        <span>Tax (5%):</span>
                        <span>₹@(Model.Sum(x => x.UnitPrice * x.Quantity) * 0.05m)</span>
                    </div>

                    <div class="summary-row total">
                        <span>Total:</span>
                        <span>₹@(Model.Sum(x => x.UnitPrice * x.Quantity) + 100)</span>
                    </div>

                    <a href="@Url.Action("Index", "Checkout")" class="btn btn-primary btn-block">Proceed to Checkout</a>
                    <a href="@Url.Action("Index", "Products")" class="btn btn-secondary btn-block">Continue Shopping</a>

                    <div class="promo-code">
                        <h4>Promo Code</h4>
                        <div style="display: flex; gap: 0.5rem;">
                            <input type="text" placeholder="Enter promo code" class="form-control" />
                            <button class="btn btn-sm">Apply</button>
                        </div>
                    </div>
                </div>

                <div class="benefits">
                    <h4>Benefits</h4>
                    <ul>
                        <li>✓ Free shipping on orders over ₹2000</li>
                        <li>✓ 30-day money-back guarantee</li>
                        <li>✓ Secure payment</li>
                        <li>✓ Fast delivery</li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="clear-cart">
            <form method="post" asp-action="ClearCart" onsubmit="return confirm('Clear entire cart?');">
                <button type="submit" class="btn btn-danger">Clear Cart</button>
            </form>
        </div>
    }
    else
    {
        <div class="empty-cart">
            <div class="empty-icon">🛒</div>
            <h2>Your Cart is Empty</h2>
            <p>Looks like you haven't added any items yet.</p>
            <a href="@Url.Action("Index", "Products")" class="btn btn-primary">Start Shopping</a>
        </div>
    }
</div>

<style>
.cart-page {
    margin: 2rem 0;
}

.cart-page h1 {
    font-size: 2rem;
    margin-bottom: 2rem;
}

.cart-container {
    display: grid;
    grid-template-columns: 1fr 350px;
    gap: 2rem;
}

.cart-items {
    background: white;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
}

.cart-table {
    width: 100%;
    border-collapse: collapse;
}

.cart-table thead {
    background: #f8f9fa;
}

.cart-table th {
    padding: 1rem;
    text-align: left;
    font-weight: bold;
    border-bottom: 2px solid #ddd;
}

.cart-table td {
    padding: 1.5rem 1rem;
    border-bottom: 1px solid #eee;
}

.product-info {
    flex: 1;
}

.product-desc {
    color: #666;
    font-size: 0.9rem;
    margin-top: 0.25rem;
}

.price, .total {
    color: #667eea;
    font-weight: bold;
}

.qty-input {
    width: 70px;
    padding: 0.5rem;
    border: 1px solid #ddd;
    border-radius: 4px;
}

.btn-sm {
    padding: 0.5rem 1rem;
    font-size: 0.9rem;
}

.summary-card {
    background: white;
    padding: 2rem;
    border-radius: 8px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    margin-bottom: 1.5rem;
}

.summary-card h3 {
    margin-bottom: 1.5rem;
}

.summary-row {
    display: flex;
    justify-content: space-between;
    padding: 0.75rem 0;
    border-bottom: 1px solid #eee;
}

.summary-row.total {
    border: none;
    border-top: 2px solid #ddd;
    padding-top: 1rem;
    margin-top: 1rem;
    font-size: 1.2rem;
    font-weight: bold;
    color: #667eea;
}

.btn-block {
    width: 100%;
    margin-top: 1rem;
    padding: 0.75rem;
    text-align: center;
}

.promo-code {
    margin-top: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid #eee;
}

.promo-code h4 {
    margin-bottom: 0.75rem;
}

.benefits {
    background: #f8f9fa;
    padding: 1.5rem;
    border-radius: 8px;
}

.benefits h4 {
    margin-bottom: 1rem;
}

.benefits ul {
    list-style: none;
    padding: 0;
}

.benefits li {
    padding: 0.5rem 0;
    color: #666;
}

.clear-cart {
    text-align: center;
    margin-top: 2rem;
}

.empty-cart {
    text-align: center;
    padding: 4rem 2rem;
    background: white;
    border-radius: 8px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
}

.empty-icon {
    font-size: 4rem;
    margin-bottom: 1rem;
}

.empty-cart h2 {
    margin-bottom: 1rem;
    color: #333;
}

.empty-cart p {
    color: #666;
    margin-bottom: 2rem;
}

@media (max-width: 768px) {
    .cart-container {
        grid-template-columns: 1fr;
    }

    .cart-table {
        font-size: 0.9rem;
    }

    .cart-table th, .cart-table td {
        padding: 0.75rem;
    }

    .qty-input {
        width: 50px;
    }

    .btn-sm {
        padding: 0.4rem 0.75rem;
        font-size: 0.8rem;
    }
}
</style>
