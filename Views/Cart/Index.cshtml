@model IEnumerable<NutShop.Models.CartItem>

@{
    ViewData["Title"] = "Shopping Cart";

    var subtotal = Model.Sum(x => x.UnitPrice * x.Quantity);
}

<div class="cart-page">

    <h1>Shopping Cart</h1>

    @if (Model.Any())
    {
        <div class="cart-container">

            <!-- LEFT SIDE: CART ITEMS -->
            <div class="cart-items">

                <table class="cart-table">

                    <thead>
                        <tr>
                            <th>Product</th>
                            <th>Price</th>
                            <th>Quantity</th>
                            <th>Total</th>
                            <th>Action</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var item in Model)
                        {
                            <tr>

                                <!-- PRODUCT -->
                                <td class="product-info">
                                    <strong>
                                        @item.Product?.Name
                                    </strong>

                                    <p class="product-desc">
                                        @item.Product?.Description
                                    </p>
                                </td>

                                <!-- PRICE -->
                                <td class="price">
                                    @item.UnitPrice.ToString("0.00") kr
                                </td>

                                <!-- QUANTITY -->
                                <td class="quantity">

                                    <form method="post"
                                          asp-action="UpdateQuantity"
                                          class="quantity-form">

                                        <input type="hidden"
                                               name="cartItemId"
                                               value="@item.Id" />

                                        <input type="number"
                                               name="quantity"
                                               value="@item.Quantity"
                                               min="1"
                                               max="@item.Product?.StockQuantity"
                                               class="qty-input" />

                                        <button type="submit"
                                                class="btn btn-sm">
                                            Update
                                        </button>

                                    </form>

                                </td>

                                <!-- ITEM TOTAL -->
                                <td class="total">
                                    @((item.UnitPrice * item.Quantity).ToString("0.00")) kr
                                </td>

                                <!-- REMOVE -->
                                <td class="remove">

                                    <form method="post"
                                          asp-action="RemoveFromCart"
                                          onsubmit="return confirm('Remove this item?');">

                                        <input type="hidden"
                                               name="cartItemId"
                                               value="@item.Id" />

                                        <button type="submit"
                                                class="btn btn-sm btn-danger">
                                            Remove
                                        </button>

                                    </form>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>


            <!-- RIGHT SIDE -->
            <div class="cart-summary">

                <div class="summary-card">

                    <h3>Order Summary</h3>

                    <div class="summary-row">
                        <span>Subtotal:</span>

                        <span>
                            @subtotal.ToString("0.00") kr
                        </span>
                    </div>

                    <div class="summary-row">
                        <span>Shipping:</span>

                        <span>
                            Calculated at checkout
                        </span>
                    </div>

                    <div class="summary-row total">
                        <span>Total:</span>

                        <span>
                            @subtotal.ToString("0.00") kr
                        </span>
                    </div>


                    <!-- BUTTONS -->
                    <div class="cart-actions">

                        <a href="@Url.Action("Index", "Checkout")"
                           class="btn btn-primary checkout-button">
                            Proceed to Checkout
                        </a>

                        <a href="@Url.Action("Index", "Products")"
                           class="btn btn-secondary continue-button">
                            Continue Shopping
                        </a>

                    </div>


                    <!-- PROMO CODE -->
                    <div class="promo-code">

                        <h4>Promo Code</h4>

                        <div class="promo-row">

                            <input type="text"
                                   placeholder="Enter promo code"
                                   class="form-control" />

                            <button type="button"
                                    class="btn btn-sm">
                                Apply
                            </button>

                        </div>

                    </div>

                </div>


                <!-- BENEFITS -->
                <div class="benefits">

                    <h4>Benefits</h4>

                    <ul>
                        <li>✓ Free shipping on orders over 1000 kr</li>
                        <li>✓ 30-day money-back guarantee</li>
                        <li>✓ Secure payment with SumUp</li>
                        <li>✓ Fast delivery in Sweden</li>
                    </ul>

                </div>

            </div>

        </div>


        <!-- CLEAR CART -->
        <div class="clear-cart">

            <form method="post"
                  asp-action="ClearCart"
                  onsubmit="return confirm('Clear entire cart?');">

                <button type="submit"
                        class="btn btn-danger">
                    Clear Cart
                </button>

            </form>

        </div>
    }
    else
    {
        <!-- EMPTY CART -->
        <div class="empty-cart">

            <div class="empty-icon">
                🛒
            </div>

            <h2>Your Cart is Empty</h2>

            <p>
                Looks like you haven't added any items yet.
            </p>

            <a href="@Url.Action("Index", "Products")"
               class="btn btn-primary">
                Start Shopping
            </a>

        </div>
    }

</div>


<style>

.cart-page {
    margin: 2rem 0;
}

.cart-page h1 {
    font-size: 2rem;
    margin-bottom: 2rem;
}


/* MAIN LAYOUT */

.cart-container {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 350px;
    gap: 2rem;
    align-items: start;
}


/* CART ITEMS */

.cart-items {
    background: white;
    border-radius: 8px;
    overflow-x: auto;
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
}


/* TABLE */

.cart-table {
    width: 100%;
    border-collapse: collapse;
}

.cart-table thead {
    background: #f8f9fa;
}

.cart-table th {
    padding: 1rem;
    text-align: left;
    font-weight: bold;
    border-bottom: 2px solid #ddd;
    white-space: nowrap;
}

.cart-table td {
    padding: 1.5rem 1rem;
    border-bottom: 1px solid #eee;
    vertical-align: middle;
}


/* PRODUCT */

.product-info {
    min-width: 180px;
}

.product-info strong {
    display: block;
}

.product-desc {
    color: #666;
    font-size: 0.9rem;
    margin-top: 0.25rem;
    margin-bottom: 0;
}


/* PRICE */

.price,
.total {
    color: #27ae60;
    font-weight: bold;
    white-space: nowrap;
}


/* QUANTITY */

.quantity-form {
    display: flex;
    align-items: center;
    gap: 0.5rem;
}

.qty-input {
    width: 70px;
    padding: 0.5rem;
    border: 1px solid #ddd;
    border-radius: 4px;
}


/* SMALL BUTTONS */

.btn-sm {
    padding: 0.5rem 1rem;
    font-size: 0.9rem;
}


/* SUMMARY */

.cart-summary {
    min-width: 0;
}

.summary-card {
    background: white;
    width: 100%;
    box-sizing: border-box;
    padding: 2rem;
    border-radius: 8px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    margin-bottom: 1.5rem;
}

.summary-card h3 {
    margin-bottom: 1.5rem;
}


/* SUMMARY ROW */

.summary-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 0.75rem 0;
    border-bottom: 1px solid #eee;
}

.summary-row span:last-child {
    text-align: right;
}


/* TOTAL */

.summary-row.total {
    border-bottom: none;
    border-top: 2px solid #ddd;
    padding-top: 1rem;
    margin-top: 1rem;
    font-size: 1.2rem;
    font-weight: bold;
    color: #27ae60;
}


/* CART BUTTONS */

.cart-actions {
    display: flex;
    flex-direction: column;
    width: 100%;
    gap: 12px;
    margin-top: 1.5rem;
}

.cart-actions .btn {
    display: flex;
    align-items: center;
    justify-content: center;

    width: 100%;
    box-sizing: border-box;

    margin: 0;

    padding: 0.9rem 1rem;

    text-align: center;
    text-decoration: none;

    line-height: 1.3;
}


/* CHECKOUT BUTTON */

.checkout-button {
    background: #27ae60;
    color: white;
}

.checkout-button:hover {
    background: #229954;
    color: white;
}


/* CONTINUE BUTTON */

.continue-button {
    background: #eef1f4;
    color: #333;
}

.continue-button:hover {
    background: #dde2e7;
    color: #333;
}


/* PROMO */

.promo-code {
    margin-top: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid #eee;
}

.promo-code h4 {
    margin-bottom: 0.75rem;
}

.promo-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
}

.promo-row .form-control {
    flex: 1;
    min-width: 0;
}


/* BENEFITS */

.benefits {
    background: #f8f9fa;
    padding: 1.5rem;
    border-radius: 8px;
}

.benefits h4 {
    margin-bottom: 1rem;
}

.benefits ul {
    list-style: none;
    padding: 0;
    margin: 0;
}

.benefits li {
    padding: 0.5rem 0;
    color: #666;
}


/* CLEAR CART */

.clear-cart {
    text-align: center;
    margin-top: 2rem;
}


/* EMPTY CART */

.empty-cart {
    text-align: center;
    padding: 4rem 2rem;
    background: white;
    border-radius: 8px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
}

.empty-icon {
    font-size: 4rem;
    margin-bottom: 1rem;
}

.empty-cart h2 {
    margin-bottom: 1rem;
    color: #333;
}

.empty-cart p {
    color: #666;
    margin-bottom: 2rem;
}


/* RESPONSIVE */

@@media (max-width: 900px) {

    .cart-container {
        grid-template-columns: 1fr;
    }

    .cart-summary {
        width: 100%;
    }

}


@@media (max-width: 768px) {

    .cart-page {
        margin: 1rem 0;
    }

    .cart-table {
        min-width: 720px;
        font-size: 0.9rem;
    }

    .cart-table th,
    .cart-table td {
        padding: 0.75rem;
    }

    .summary-card {
        padding: 1.25rem;
    }

}


@@media (max-width: 480px) {

    .qty-input {
        width: 55px;
    }

    .btn-sm {
        padding: 0.45rem 0.65rem;
        font-size: 0.8rem;
    }

    .promo-row {
        flex-direction: column;
        align-items: stretch;
    }

    .promo-row .btn {
        width: 100%;
    }

}

</style>