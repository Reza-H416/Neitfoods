<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - NeitFoods NutShop</title>
    <link rel="stylesheet" href="~/css/style.css" />
    <link rel="stylesheet" href="~/css/responsive.css" />
</head>
<body>
    <header>
        <nav class="navbar">
            <div class="container">
                <div class="navbar-brand">
                    <a href="/">🥜 NeitFoods NutShop</a>
                </div>

                <ul class="nav-menu">
                    <li><a href="/">Home</a></li>
                    <li><a href="/Products">Shop</a></li>
                    <li><a href="/Cart">🛒 Cart</a></li>

                    @{
                        var userId = Context.Session.GetInt32("UserId");
                        var isAdmin = !string.IsNullOrEmpty(Context.Session.GetString("IsAdmin"));
                    }

                    @if (userId.HasValue)
                    {
                        <li class="dropdown">
                            <a href="#">👤 Account</a>
                            <ul class="dropdown-menu">
                                <li><a href="/Account/Profile">My Profile</a></li>
                                <li><a href="/Account/Logout">Logout</a></li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li><a href="/Account/Login">Sign In</a></li>
                        <li><a href="/Account/Register">Sign Up</a></li>
                    }

                    @if (isAdmin)
                    {
                        <li><a href="/Admin/Dashboard" class="admin-link">📊 Admin</a></li>
                    }
                </ul>
            </div>
        </nav>
    </header>

    <main class="container">
        @RenderBody()
    </main>

    <footer>
        <div class="footer-content">
            <div class="footer-section">
                <h3>About NeitFoods</h3>
                <p>Premium nuts and dried fruits sourced from the finest suppliers around the world.</p>
            </div>

            <div class="footer-section">
                <h3>Quick Links</h3>
                <ul>
                    <li><a href="/Products">Products</a></li>
                    <li><a href="/Account/Login">My Account</a></li>
                    <li><a href="/">About Us</a></li>
                </ul>
            </div>

            <div class="footer-section">
                <h3>Contact</h3>
                <p>
                    📧 info@neitfoods.com<br />
                    📞 +46 70 000 00 00<br />
                    📍 Sweden
                </p>
            </div>

            <div class="footer-section">
                <h3>Follow Us</h3>
                <p>
                    <a href="#">Facebook</a> |
                    <a href="#">Instagram</a> |
                    <a href="#">Twitter</a>
                </p>
            </div>
        </div>

        <div class="footer-bottom">
            <p>&copy; 2024 NeitFoods - Premium Nuts & Dried Fruits. All rights reserved.</p>
        </div>
    </footer>

    <script src="~/js/script.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

<style>
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html, body {
    height: 100%;
}

body {
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    background-color: #f5f5f5;
    color: #333;
    line-height: 1.6;
    display: flex;
    flex-direction: column;
}

main {
    flex: 1;
}

header {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    position: sticky;
    top: 0;
    z-index: 100;
}

.navbar {
    padding: 0;
}

.container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
}

.navbar .container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 20px;
}

.navbar-brand a {
    color: white;
    font-weight: bold;
    font-size: 1.5rem;
    text-decoration: none;
}

.nav-menu {
    list-style: none;
    display: flex;
    gap: 2rem;
    align-items: center;
}

.nav-menu a {
    color: white;
    text-decoration: none;
    transition: color 0.3s;
    font-weight: 500;
}

.nav-menu a:hover {
    color: #ffeb3b;
}

.admin-link {
    background: rgba(255,255,255,0.2);
    padding: 0.5rem 1rem;
    border-radius: 4px;
}

.admin-link:hover {
    background: rgba(255,255,255,0.3);
}

.dropdown {
    position: relative;
}

.dropdown-menu {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    background: white;
    list-style: none;
    padding: 0.5rem 0;
    border-radius: 4px;
    box-shadow: 0 4px 8px rgba(0,0,0,0.15);
    min-width: 150px;
}

.dropdown:hover .dropdown-menu {
    display: block;
}

.dropdown-menu li {
    padding: 0;
}

.dropdown-menu a {
    display: block;
    padding: 0.75rem 1.5rem;
    color: #333;
}

.dropdown-menu a:hover {
    background: #f8f9fa;
    color: #667eea;
}

footer {
    background: #2c3e50;
    color: white;
    padding: 3rem 0 1rem;
    margin-top: 3rem;
}

.footer-content {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 2rem;
    margin-bottom: 2rem;
}

.footer-section h3 {
    margin-bottom: 1rem;
    color: #fff;
}

.footer-section p {
    color: #bbb;
    font-size: 0.95rem;
}

.footer-section a {
    color: #bbb;
    text-decoration: none;
}

.footer-section a:hover {
    color: #fff;
}

.footer-section ul {
    list-style: none;
}

.footer-section ul li {
    padding: 0.5rem 0;
}

.footer-bottom {
    border-top: 1px solid #444;
    padding-top: 1rem;
    text-align: center;
    color: #999;
}

.alert {
    padding: 1rem;
    border-radius: 4px;
    margin-bottom: 1rem;
}

.alert-danger {
    background: #f8d7da;
    color: #721c24;
    border: 1px solid #f5c6cb;
}

.alert-success {
    background: #d4edda;
    color: #155724;
    border: 1px solid #c3e6cb;
}

.btn {
    background-color: #667eea;
    color: white;
    padding: 0.75rem 1.5rem;
    border: none;
    border-radius: 4px;
    cursor: pointer;
    font-size: 1rem;
    transition: background-color 0.3s;
    text-decoration: none;
    display: inline-block;
}

.btn:hover {
    background-color: #5568d3;
}

.btn-primary {
    background-color: #667eea;
}

.btn-primary:hover {
    background-color: #5568d3;
}

.btn-secondary {
    background-color: #6c757d;
}

.btn-secondary:hover {
    background-color: #5a6268;
}

.btn-danger {
    background-color: #dc3545;
}

.btn-danger:hover {
    background-color: #c82333;
}

@@media (max-width: 768px) {
    .navbar .container {
        flex-wrap: wrap;
    }

    .nav-menu {
        flex-direction: column;
        gap: 1rem;
        width: 100%;
    }

    main {
        padding: 1rem 0;
    }

    .container {
        padding: 0 10px;
    }

    .footer-content {
        grid-template-columns: 1fr;
        gap: 1rem;
    }
}
</style>
