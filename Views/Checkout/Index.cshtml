@{
    ViewData["Title"] = "Checkout";
}

<div class="checkout-page">
    <div class="checkout-container">
        <div class="checkout-content">
            <h1>Checkout</h1>

            <div class="checkout-steps">
                <div class="step active">
                    <span class="step-number">1</span>
                    <span class="step-label">Order Summary</span>
                </div>
                <div class="step active">
                    <span class="step-number">2</span>
                    <span class="step-label">Shipping Details</span>
                </div>
                <div class="step">
                    <span class="step-number">3</span>
                    <span class="step-label">Payment</span>
                </div>
            </div>

            <div class="checkout-main">
                <div class="order-summary">
                    <h2>Order Summary</h2>
                    @if (ViewBag.CartItems != null && ViewBag.CartItems.Count > 0)
                    {
                        <div class="order-items">
                            @foreach (var item in ViewBag.CartItems)
                            {
                                <div class="order-item">
                                    <div class="item-details">
                                        <p class="item-name">@item.Product?.Name</p>
                                        <p class="item-qty">Qty: @item.Quantity</p>
                                    </div>
                                    <p class="item-price">₹@(item.UnitPrice * item.Quantity)</p>
                                </div>
                            }
                        </div>

                        <div class="order-total">
                            <div class="total-row">
                                <span>Subtotal:</span>
                                <span>₹@(ViewBag.Total - (ViewBag.Total * 0.05))</span>
                            </div>
                            <div class="total-row">
                                <span>Shipping:</span>
                                <span>₹100</span>
                            </div>
                            <div class="total-row">
                                <span>Tax (5%):</span>
                                <span>₹@(ViewBag.Total * 0.05)</span>
                            </div>
                            <div class="total-row grand-total">
                                <span>Total:</span>
                                <span>₹@(ViewBag.Total + 100)</span>
                            </div>
                        </div>
                    }
                </div>

                <div class="checkout-form">
                    <h2>Shipping Address</h2>
                    <form method="post" asp-action="ProcessOrder">
                        <div class="user-info">
                            @if (ViewBag.User != null)
                            {
                                <div class="form-group">
                                    <label>Name</label>
                                    <input type="text" value="@ViewBag.User.FullName" class="form-control" disabled />
                                </div>

                                <div class="form-group">
                                    <label>Email</label>
                                    <input type="email" value="@ViewBag.User.Email" class="form-control" disabled />
                                </div>
                            }
                        </div>

                        <div class="form-group">
                            <label for="phoneNumber">Phone Number *</label>
                            <input type="tel" id="phoneNumber" name="phoneNumber" class="form-control"
                                   value="@ViewBag.User?.PhoneNumber" required />
                        </div>

                        <div class="form-group">
                            <label for="shippingAddress">Shipping Address *</label>
                            <textarea id="shippingAddress" name="shippingAddress" class="form-control" rows="4"
                                      required>@ViewBag.User?.ShippingAddress</textarea>
                        </div>

                        <div class="terms-check">
                            <input type="checkbox" id="terms" name="terms" required />
                            <label for="terms">I agree to the terms and conditions</label>
                        </div>

                        <button type="submit" class="btn btn-primary btn-lg">Proceed to Payment</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
.checkout-page {
    background: #f8f9fa;
    padding: 2rem 0;
    min-height: 100vh;
}

.checkout-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1rem;
}

.checkout-content h1 {
    font-size: 2rem;
    margin-bottom: 2rem;
}

.checkout-steps {
    display: flex;
    justify-content: space-between;
    margin-bottom: 3rem;
}

.step {
    display: flex;
    align-items: center;
    gap: 1rem;
    opacity: 0.5;
}

.step.active {
    opacity: 1;
}

.step-number {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: #667eea;
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: bold;
}

.step.active .step-number {
    background: #667eea;
}

.step-label {
    font-weight: bold;
}

.checkout-main {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
}

.order-summary {
    background: white;
    padding: 2rem;
    border-radius: 8px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    height: fit-content;
}

.order-summary h2 {
    margin-bottom: 1.5rem;
    font-size: 1.3rem;
}

.order-items {
    margin-bottom: 2rem;
}

.order-item {
    display: flex;
    justify-content: space-between;
    padding: 1rem 0;
    border-bottom: 1px solid #eee;
}

.item-details {
    flex: 1;
}

.item-name {
    font-weight: bold;
    margin: 0 0 0.5rem 0;
}

.item-qty {
    color: #666;
    font-size: 0.9rem;
    margin: 0;
}

.item-price {
    font-weight: bold;
    color: #667eea;
}

.order-total {
    background: #f8f9fa;
    padding: 1rem;
    border-radius: 4px;
}

.total-row {
    display: flex;
    justify-content: space-between;
    margin-bottom: 0.5rem;
    font-size: 0.95rem;
}

.total-row.grand-total {
    border-top: 2px solid #ddd;
    padding-top: 1rem;
    margin-top: 1rem;
    font-size: 1.2rem;
    font-weight: bold;
    color: #667eea;
}

.checkout-form {
    background: white;
    padding: 2rem;
    border-radius: 8px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
}

.checkout-form h2 {
    margin-bottom: 1.5rem;
    font-size: 1.3rem;
}

.user-info {
    background: #f8f9fa;
    padding: 1rem;
    border-radius: 4px;
    margin-bottom: 1.5rem;
}

.form-group {
    margin-bottom: 1.5rem;
}

.form-group label {
    display: block;
    margin-bottom: 0.5rem;
    font-weight: bold;
    color: #333;
}

.form-control {
    width: 100%;
    padding: 0.75rem;
    border: 1px solid #ddd;
    border-radius: 4px;
    font-size: 1rem;
}

.form-control:disabled {
    background: #e9ecef;
    cursor: not-allowed;
}

.terms-check {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 2rem;
}

.terms-check input {
    width: 20px;
    height: 20px;
    cursor: pointer;
}

.btn-lg {
    width: 100%;
    padding: 1rem;
    font-size: 1.1rem;
}

@@media (max-width: 768px) {
    .checkout-main {
        grid-template-columns: 1fr;
    }

    .checkout-steps {
        flex-direction: column;
        gap: 1rem;
    }
}
</style>
