@{
    ViewData["Title"] = "Checkout";

    var cartItems = ViewBag.CartItems as IEnumerable<NutShop.Models.CartItem>;
    decimal total = ViewBag.Total != null
        ? Convert.ToDecimal(ViewBag.Total)
        : 0;
}

<div class="checkout-page">

    <h1>Checkout</h1>

    <!-- STEPS -->
    <div class="checkout-steps">

        <div class="checkout-step active">
            <span>1</span>
            <strong>Order Summary</strong>
        </div>

        <div class="step-line"></div>

        <div class="checkout-step active">
            <span>2</span>
            <strong>Delivery Details</strong>
        </div>

        <div class="step-line"></div>

        <div class="checkout-step">
            <span>3</span>
            <strong>Payment</strong>
        </div>

    </div>


    @if (ViewBag.Error != null)
    {
        <div class="checkout-error">
            @ViewBag.Error
        </div>
    }


    <div class="checkout-layout">

        <!-- LEFT: ORDER SUMMARY -->
        <div class="checkout-summary-card">

            <h2>Order Summary</h2>

            @if (cartItems != null)
            {
                foreach (var item in cartItems)
                {
                    <div class="checkout-product">

                        <div>
                            <strong>@item.Product?.Name</strong>

                            <span>
                                Qty: @item.Quantity
                            </span>
                        </div>

                        <strong class="checkout-price">
                            @((item.UnitPrice * item.Quantity).ToString("0.00")) kr
                        </strong>

                    </div>
                }
            }

            <div class="checkout-totals">

                <div class="checkout-total-row">
                    <span>Subtotal</span>
                    <span>@total.ToString("0.00") kr</span>
                </div>

                <div class="checkout-total-row">
                    <span>Shipping</span>
                    <span>Calculated later</span>
                </div>

                <div class="checkout-grand-total">
                    <span>Total</span>
                    <strong>@total.ToString("0.00") kr</strong>
                </div>

            </div>

        </div>


        <!-- RIGHT: DELIVERY DETAILS -->
        <div class="checkout-form-card">

            <h2>Delivery Details</h2>

            <p class="checkout-help">
                Enter the address where you want your order delivered.
            </p>


            <form method="post"
                  asp-controller="Checkout"
                  asp-action="ProcessOrder">

                @Html.AntiForgeryToken()


                <!-- NAME -->
                <div class="checkout-row">

                    <div class="checkout-field">
                        <label for="firstName">
                            First name *
                        </label>

                        <input type="text"
                               id="firstName"
                               name="firstName"
                               autocomplete="given-name"
                               placeholder="Reza"
                               required />
                    </div>


                    <div class="checkout-field">
                        <label for="lastName">
                            Last name *
                        </label>

                        <input type="text"
                               id="lastName"
                               name="lastName"
                               autocomplete="family-name"
                               placeholder="Ahmadi"
                               required />
                    </div>

                </div>


                <!-- EMAIL -->
                <div class="checkout-field">

                    <label for="email">
                        Email *
                    </label>

                    <input type="email"
                           id="email"
                           name="email"
                           value="@ViewBag.User?.Email"
                           autocomplete="email"
                           placeholder="name@example.com"
                           required />

                </div>


                <!-- PHONE -->
                <div class="checkout-field">

                    <label for="phoneNumber">
                        Phone number *
                    </label>

                    <input type="tel"
                           id="phoneNumber"
                           name="phoneNumber"
                           value="@ViewBag.User?.PhoneNumber"
                           autocomplete="tel"
                           placeholder="070 123 45 67"
                           required />

                </div>


                <!-- STREET -->
                <div class="checkout-field">

                    <label for="streetAddress">
                        Street address *
                    </label>

                    <input type="text"
                           id="streetAddress"
                           name="streetAddress"
                           autocomplete="street-address"
                           placeholder="Storgatan 12"
                           required />

                </div>


                <!-- POSTAL + CITY -->
                <div class="checkout-address-row">

                    <div class="checkout-field">

                        <label for="postalCode">
                            Postal code *
                        </label>

                        <input type="text"
                               id="postalCode"
                               name="postalCode"
                               placeholder="211 22"
                               autocomplete="postal-code"
                               maxlength="6"
                               pattern="[0-9]{3}\s?[0-9]{2}"
                               required />

                    </div>


                    <div class="checkout-field">

                        <label for="city">
                            City *
                        </label>

                        <input type="text"
                               id="city"
                               name="city"
                               placeholder="Malmö"
                               autocomplete="address-level2"
                               required />

                    </div>

                </div>


                <!-- COUNTRY -->
                <div class="checkout-field">

                    <label for="country">
                        Country
                    </label>

                    <input type="text"
                           id="country"
                           value="Sweden"
                           readonly />

                </div>


                <!-- TERMS -->
                <label class="checkout-terms">

                    <input type="checkbox"
                           id="terms"
                           name="terms"
                           required />

                    <span>
                        I agree to the terms and conditions
                    </span>

                </label>


                <!-- PAYMENT -->
                <button type="submit"
                        class="checkout-payment-button">

                    Pay securely with SumUp

                </button>

            </form>

        </div>

    </div>

</div>


<style>

.checkout-page {
    max-width: 1200px;
    margin: 0 auto;
    padding: 30px 20px 60px;
}

.checkout-page h1 {
    font-size: 2.2rem;
    margin-bottom: 30px;
}


/* STEPS */

.checkout-steps {
    display: flex;
    align-items: center;
    margin-bottom: 40px;
}

.checkout-step {
    display: flex;
    align-items: center;
    gap: 12px;
    white-space: nowrap;
    color: #999;
}

.checkout-step span {
    width: 40px;
    height: 40px;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 50%;

    background: #d9e1ff;
    color: white;

    font-weight: bold;
}

.checkout-step.active {
    color: #333;
}

.checkout-step.active span {
    background: #667eea;
}

.step-line {
    height: 2px;
    background: #e5e7eb;
    flex: 1;
    margin: 0 20px;
}


/* LAYOUT */

.checkout-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(380px, 1fr);
    gap: 32px;
    align-items: start;
}


/* CARDS */

.checkout-summary-card,
.checkout-form-card {
    background: white;
    padding: 32px;

    border-radius: 12px;

    box-shadow:
        0 3px 14px rgba(0,0,0,0.08);
}

.checkout-summary-card h2,
.checkout-form-card h2 {
    margin-top: 0;
    margin-bottom: 24px;
}


/* PRODUCTS */

.checkout-product {
    display: flex;
    justify-content: space-between;
    gap: 20px;

    padding: 18px 0;

    border-bottom: 1px solid #eee;
}

.checkout-product div {
    display: flex;
    flex-direction: column;
    gap: 6px;
}

.checkout-product span {
    color: #777;
    font-size: 0.9rem;
}

.checkout-price {
    color: #667eea;
    white-space: nowrap;
}


/* TOTALS */

.checkout-totals {
    margin-top: 30px;

    padding: 18px;

    background: #f8f9fb;

    border-radius: 8px;
}

.checkout-total-row {
    display: flex;
    justify-content: space-between;

    padding: 8px 0;

    gap: 20px;
}

.checkout-grand-total {
    display: flex;
    justify-content: space-between;

    margin-top: 14px;
    padding-top: 16px;

    border-top: 2px solid #ddd;

    font-size: 1.3rem;
}

.checkout-grand-total strong {
    color: #667eea;
}


/* HELP TEXT */

.checkout-help {
    margin-top: -12px;
    margin-bottom: 25px;

    color: #777;

    font-size: 0.95rem;
}


/* FORM */

.checkout-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
}

.checkout-address-row {
    display: grid;
    grid-template-columns: 150px 1fr;
    gap: 16px;
}

.checkout-field {
    margin-bottom: 18px;
}

.checkout-field label {
    display: block;

    margin-bottom: 7px;

    font-weight: 600;

    color: #333;
}

.checkout-field input {
    width: 100%;

    box-sizing: border-box;

    padding: 12px 13px;

    border: 1px solid #d5d8dd;
    border-radius: 6px;

    font-size: 1rem;

    background: white;

    transition:
        border-color 0.2s,
        box-shadow 0.2s;
}

.checkout-field input:focus {
    outline: none;

    border-color: #667eea;

    box-shadow:
        0 0 0 3px rgba(102,126,234,0.12);
}

.checkout-field input[readonly] {
    background: #f4f5f7;
    color: #666;
}


/* TERMS */

.checkout-terms {
    display: flex;
    align-items: flex-start;

    gap: 10px;

    margin: 8px 0 22px;

    cursor: pointer;

    font-weight: 600;
}

.checkout-terms input {
    width: 19px;
    height: 19px;

    margin-top: 2px;
}


/* PAYMENT BUTTON */

.checkout-payment-button {
    width: 100%;

    padding: 15px 20px;

    border: none;
    border-radius: 6px;

    background: #27ae60;

    color: white;

    font-size: 1.05rem;
    font-weight: 600;

    cursor: pointer;
}

.checkout-payment-button:hover {
    background: #229954;
}


/* ERROR */

.checkout-error {
    padding: 14px 18px;

    margin-bottom: 20px;

    border-radius: 6px;

    background: #fdeaea;

    color: #b42318;
}


/* RESPONSIVE */

@@media (max-width: 900px) {

    .checkout-layout {
        grid-template-columns: 1fr;
    }

}


@@media (max-width: 700px) {

    .checkout-steps strong {
        display: none;
    }

    .step-line {
        margin: 0 10px;
    }

    .checkout-row,
    .checkout-address-row {
        grid-template-columns: 1fr;
        gap: 0;
    }

    .checkout-summary-card,
    .checkout-form-card {
        padding: 22px;
    }

}


@@media (max-width: 480px) {

    .checkout-page {
        padding: 20px 10px 40px;
    }

    .checkout-step span {
        width: 34px;
        height: 34px;
    }

}

</style>